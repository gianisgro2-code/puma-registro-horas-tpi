<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Puma" targetNamespace="https://puma.example/horas" exporter="Modelo académico Puma">
  <bpmn:collaboration id="Collaboration_Puma">
    <bpmn:participant id="Pool_Puma" name="Puma Lubricants" processRef="Process_Puma" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Puma" name="Registro de jornadas y autorización de horas extras" isExecutable="false">
    <bpmn:laneSet id="Lanes_Puma">
      <bpmn:lane id="Lane_0" name="Operario de Producción">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jornada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gExtra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sinExtra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>solicitar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Sistema">
        <bpmn:flowNodeRef>validarJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>validarS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>union</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Supervisión de Producción">
        <bpmn:flowNodeRef>revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>motivo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Administración">
        <bpmn:flowNodeRef>reporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Inicio de jornada">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="jornada" name="Registrar entrada y, al finalizar, salida y pausas">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="validarJ" name="Validar jornada">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gJ" name="¿Jornada válida?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="calcular" name="Calcular tiempo trabajado y extras disponibles">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gExtra" name="¿Solicita extras?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sinExtra" name="Jornada registrada sin solicitud">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="solicitar" name="Ingresar minutos y motivo; enviar solicitud">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:serviceTask id="validarS" name="Validar solicitud">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gS" name="¿Solicitud válida?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="pendiente" name="Guardar solicitud pendiente">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="revisar" name="Revisar jornada y solicitud">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gA" name="¿Aprueba?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="aprobar" name="Guardar aprobada y resolución">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="motivo" name="Indicar motivo del rechazo">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="rechazar" name="Guardar rechazada y resolución">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="union" name="">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="reporte" name="Consultar reportes por empleado y período">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Consulta finalizada">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="jornada" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="jornada" targetRef="validarJ" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="validarJ" targetRef="gJ" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="gJ" targetRef="jornada" name="No: corregir" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="gJ" targetRef="calcular" name="Sí" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="calcular" targetRef="gExtra" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="gExtra" targetRef="sinExtra" name="No" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="gExtra" targetRef="solicitar" name="Sí" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="solicitar" targetRef="validarS" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="validarS" targetRef="gS" name="" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="gS" targetRef="solicitar" name="No: corregir" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="gS" targetRef="pendiente" name="Sí" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="pendiente" targetRef="revisar" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="revisar" targetRef="gA" name="" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="gA" targetRef="aprobar" name="Sí" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="gA" targetRef="motivo" name="No" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="motivo" targetRef="rechazar" name="" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="aprobar" targetRef="union" name="" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="rechazar" targetRef="union" name="" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="union" targetRef="reporte" name="" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="reporte" targetRef="fin" name="" />
  </bpmn:process>
